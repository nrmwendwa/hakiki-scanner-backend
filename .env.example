# ============================================================================
# Hakiki Scanner API Configuration
# ============================================================================
# Copy this file to .env and fill in your values

# ============================================================================
# API Configuration
# ============================================================================
# API host to bind to (0.0.0.0 for all interfaces)
API_HOST=0.0.0.0

# API port
API_PORT=8000

# Enable debug mode (True/False)
DEBUG=False

# Number of worker processes for production (ignored in debug mode)
WORKERS=4

# ============================================================================
# LLM Configuration (Gemini)
# ============================================================================
# Required: your Gemini API key
GEMINI_API_KEY=AIzaSyDOYiWY7SQLQ8q9aQ8EgXSXQjJt8Zlvhvc

# Gemini model identifier (used for both text and vision tasks)
GEMINI_MODEL=gemma-4-31b-it

# ============================================================================
# File Upload Configuration
# ============================================================================
# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=10

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins
# Include your frontend URL when deploying
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

